        <provider
            android:name="dev.dioxus.solana.MwaInitProvider"
            android:authorities="${applicationId}.dev.dioxus.solana.mwa"
            android:exported="false"
            android:initOrder="1000" />
    </application>
    <queries>
        <intent>
            <action android:name="solana.mobilewalletadapter.intent.action.ASSOCIATE" />
        </intent>
    </queries>
</manifest>
